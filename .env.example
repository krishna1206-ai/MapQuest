# MapQuest Developer key — https://developer.mapquest.com/user/me/apps
EXPO_PUBLIC_MAPQUEST_API_KEY=

# Distance units: imperial (mi) or metric (km)
EXPO_PUBLIC_UNITS=imperial

# Raster tile templates (OpenStreetMap by default). For production traffic,
# point these at your own tile server or a commercial provider.
EXPO_PUBLIC_TILE_URL_LIGHT=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_TILE_URL_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
